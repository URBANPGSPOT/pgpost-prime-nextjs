# WordPress GraphQL Endpoint (Must be publicly accessible for Next.js / Vercel)
WORDPRESS_API_URL=https://wp.pgspot.co.in/graphql

# WordPress Base URL (Used for media assets & rewrites - no trailing slash)
WORDPRESS_BASE_URL=https://wp.pgspot.co.in

# Frontend Domain URL
NEXT_PUBLIC_FRONTEND_URL=https://pgspot.co.in

# WordPress Public Base URL for client-side forms
NEXT_PUBLIC_WORDPRESS_URL=https://wp.pgspot.co.in
